# ─────────────────────────────────────────────────────────────────────────────
#  Open WR — Environment Variables
#  Copy this file to .env and fill in the values.
#    cp .env.example .env
#
#  .env is gitignored. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port to expose on the host (Docker Compose)
PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────

# REQUIRED — HMAC-SHA256 signing secret for cookies.
# Must be at least 32 characters. Generate one:
#   openssl rand -base64 32
COOKIE_SECRET=

# Admin API key — protects GET /api/rooms and /api/rooms/{id}/stats.
# Leave blank to disable auth (development only!).
# Generate one: openssl rand -hex 20
ADMIN_KEY=

# Set to true when serving via HTTPS to enforce Secure cookie flag.
SECURE_COOKIES=false

# ── Origin ────────────────────────────────────────────────────────────────────

# URL of your backend origin server.
# Leave blank to use the built-in demo handler.
ORIGIN=

# ── CORS ──────────────────────────────────────────────────────────────────────

# Allowed origin for the /__owr/waiting-room/status CORS header.
# Use your frontend domain in production, e.g. https://myapp.com
# "*" = allow all (development default)
CORS_ORIGIN=*

# ── Redis ─────────────────────────────────────────────────────────────────────

# Port Redis is exposed on the host (Docker Compose)
REDIS_PORT=6379

# Max memory for Redis (e.g. 256mb, 1gb)
REDIS_MAX_MEMORY=256mb

# ── Redis Commander UI (profile: redis-ui) ────────────────────────────────────
REDIS_UI_PORT=8081
REDIS_UI_USER=admin
REDIS_UI_PASSWORD=admin
